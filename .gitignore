node_modules/
dist/

*.tsbuildinfo

.env
.env.*

coverage/

.vscode/settings.json

# Component Catalog Generator output (Mission M-007, widened to the full
# universe by Mission M-012) — locally-generated from a licensed Star
# Citizen install via StarBreaker. Full-fidelity, developer-only: carries
# raw DataCore record IDs/paths/provenance never needed at runtime. Not
# committed — see RC-008 below for what IS committed. Narrowly scoped to
# these files so other generated-data/*.json fixtures stay tracked as
# before.
generated-data/component-metadata-catalog.json

# Ship & Ground Vehicle Catalog Generator output (Mission M-012) — same
# licensing posture as the component catalog above.
generated-data/ship-catalog.json

# RC-008 (Portable Runtime Catalog Certification) — deliberately NOT
# gitignored: generated-data/ship-catalog.runtime.json and
# generated-data/component-metadata-catalog.runtime.json are small,
# derived subsets of the two full catalogs above, containing only
# resolved ship/component names, manufacturer, career/role, and
# size/grade — the same class of factual, publicly-published identity
# data as RSI's own public ship listing, not a redistribution of raw
# DataCore records or any extracted asset. These ARE committed so a fresh
# GitHub clone gets certified naming/classification without StarBreaker
# or a Star Citizen install. Regenerated automatically alongside the full
# catalogs by `npm run generate:ship-catalog` / `generate:component-catalog`
# — never hand-edited.

# Scratch directory for the one-time English localization table extracted
# from the P4K (Mission M-012) — a build artifact of the generators above,
# not source data; regenerated automatically on next run if missing.
.localization-cache/

# Operation Golden Fleet (GF-002B) staged StarBreaker exports and the
# acquisition report/state — same licensing posture as the catalogs above
# (locally generated from a licensed Star Citizen install, never
# committed). Never promoted into raw-data/ automatically; see
# docs/OPERATION_GOLDEN_FLEET.md's GF-002B section and the reserved
# GF-002C promotion step.
staging-data/
